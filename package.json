{
  "name": "ekatmya-yatra",
  "version": "0.1.0",
  "private": true,
  "description": "Ek Aatam Yatra — lightweight responsive web platform for the Bharat Yatra for Oneness",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:promote": "tsx src/db/promote.ts",
    "db:reset": "rm -rf .pglite && pnpm db:migrate && pnpm db:seed",
    "db:reset-demo": "tsx src/db/reset-demo.ts",
    "test:e2e": "node tests/e2e.mjs",
    "test:responsive": "node tests/responsive.mjs",
    "test:consistency": "node tests/consistency.mjs",
    "test:mobile": "node tests/mobile.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@heroui/react": "3.2.4",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.12",
    "lucide-react": "1.44.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "playwright": "^1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.24.0"
}
