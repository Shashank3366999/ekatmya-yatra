# ---------------------------------------------------------------------------
# Ek Aatam Yatra — environment
# ---------------------------------------------------------------------------

# Set to "production" ONLY on the deployed instance (the systemd unit does it).
# It is what makes the app refuse to start with a missing DATABASE_URL or with
# the example secret below, both of which fail silently otherwise. Leave it
# unset locally: `next build` and `next start` set NODE_ENV=production too, so
# keying these checks on NODE_ENV broke local builds.
# APP_ENV="production"

# Secret used to sign session cookies. REQUIRED in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="dev-only-insecure-secret-change-me-in-production-000000"

# Postgres connection string.
# Leave EMPTY for local development: the app transparently falls back to
# PGlite (embedded Postgres, stored in ./.pglite) so no DB server is needed.
# Set it in staging/production to a managed Postgres (Neon, Supabase, RDS...).
# DATABASE_URL="postgresql://user:pass@host:5432/ekatmya_yatra"
DATABASE_URL=""

# Seeded super-admin credentials (dev convenience only).
SEED_ADMIN_EMAIL="admin@ekatmadham.com"
SEED_ADMIN_PASSWORD="Yatra@2026"

# Seed the demo accounts and fixtures. They carry a password written down in
# this repository, so they are only included automatically on a local PGlite
# database. Set this for a staging environment that needs the e2e fixtures.
# SEED_DEMO="1"
