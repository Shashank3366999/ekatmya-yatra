# Secret used to sign session cookies. REQUIRED in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="dev-only-insecure-secret-change-me-in-production-000000"

# Postgres connection string.
# Leave EMPTY for local development: the app transparently falls back to
# PGlite (embedded Postgres, stored in ./.pglite) so no DB server is needed.
# Set it in staging/production to a managed Postgres (Neon, Supabase, RDS...).
# DATABASE_URL="postgresql://user:pass@host:5432/ekatmya_yatra"
DATABASE_URL=""

# Seeded super-admin credentials (dev convenience only).
SEED_ADMIN_EMAIL="admin@ekatmadham.com"
SEED_ADMIN_PASSWORD="Yatra@2026"
