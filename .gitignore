node_modules/
.next/
out/
build/
.pglite/
*.tsbuildinfo
next-env.d.ts
.env
.env.local
.env*.local
.DS_Store
npm-debug.log*

# Large source media. The 86 MB film would sit in git history forever and make
# every clone expensive; the small derived assets it produces ARE committed.
# See public/video/README.md for where to put the original.
public/video/*.mp4
!public/video/intro.mp4
!public/video/intro-sm.mp4

# Private keys. The EC2 keypair lives here during setup; committing it would
# publish SSH access to the server for as long as the key exists, and git
# history keeps it even after a delete. Ignored by pattern rather than by name
# so the next one is covered too.
*.pem
*.key
id_rsa*
id_ed25519*
